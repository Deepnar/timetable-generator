# Database Configuration (Postgres via Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=timetable_db

# SQLAlchemy Connection Settings
DB_HOST=localhost
DB_PORT=5433
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# Application Secrets
SECRET_KEY=your-strong-random-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Async Generation (Celery + Redis, docker/docker-compose.yml)
# Set ASYNC_GENERATION=true to make POST /generate enqueue a Celery task and
# return immediately (status=PENDING). Leave false (default) to keep running
# the solver synchronously inside the HTTP request. The worker is started with:
#   uv run celery -A app.worker:celery_app worker --loglevel=info
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ASYNC_GENERATION=false

# Redis-backed infrastructure (locking / response caching / auth rate limiting).
# Set REDIS_ENABLED=false to disable all three without touching the broker.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Email notifications on publish (app/services/mail_service.py).
# Leave SMTP_HOST and SMTP_FROM empty to keep the mailer a no-op; set them
# (plus EMAIL_ENABLED=true) to send faculty/HOD/incharge PDFs on publish.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser origins allowed by CORS (comma-separated). The dev defaults cover
# the frontend on localhost:3000/3001; add the deployed frontend origin in prod.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
