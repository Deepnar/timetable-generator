# Base URL of the timetable API (FastAPI). The frontend calls the versioned
# endpoints under /api/v1 (and /auth/login for the token) directly — no Next
# rewrite proxy, per DD-019. The backend CORS allow-list includes
# http://localhost:3000 (app/main.py) so the browser can talk to it.
NEXT_PUBLIC_API_URL=http://localhost:8000
